  "html": "<body style=\"font: 14px/1.4 sans-serif; margin: 24px\">\n<h1 style=\"font-size: 20px; margin: 0\">Three frames that point into the network</h1>\n<p style=\"margin: 14px 0 4px\">Loopback address: <code>http://127.0.0.1:8080/admin</code></p><iframe src=\"http://127.0.0.1:8080/admin\" style=\"width: 100%; height: 150px; border: 1px solid #94a3b8\"></iframe>\n<p style=\"margin: 14px 0 4px\">127.0.0.1 as one decimal number: <code>http://2130706433:8169/latest/meta-data/iam/security-credentials/render-role</code></p><iframe src=\"http://2130706433:8169/latest/meta-data/iam/security-credentials/render-role\" style=\"width: 100%; height: 150px; border: 1px solid #94a3b8\"></iframe>\n<p style=\"margin: 14px 0 4px\">IPv4-mapped IPv6 address: <code>http://[::ffff:127.0.0.1]:8080/admin</code></p><iframe src=\"http://[::ffff:127.0.0.1]:8080/admin\" style=\"width: 100%; height: 150px; border: 1px solid #94a3b8\"></iframe>\n</body>"
